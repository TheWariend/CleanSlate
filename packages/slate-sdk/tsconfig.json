{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Matches the fork's tsconfig.base so the vendored modules compile
    // unmodified; see VENDOR.md.
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": false,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "useDefineForClassFields": false,

    // The SDK's own additions: no DI decorators, and const enums may not cross
    // module boundaries.
    "experimentalDecorators": false,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
