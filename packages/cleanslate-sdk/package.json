{
  "name": "@cleanslate/sdk",
  "version": "1.0.3",
  "description": "Slate agent runtime: execution loop, tool protocol, edit engine and Node host.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.test.*",
    "VENDOR.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@aws-sdk/client-bedrock": "^3.1096.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1096.0",
    "@aws-sdk/credential-provider-ini": "^3.973.7",
    "@aws-sdk/credential-provider-node": "^3.972.73",
    "@google/genai": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/node-http-handler": "^4.9.13",
    "@vscode/tree-sitter-wasm": "^0.1.4",
    "https-proxy-agent": "^7.0.6",
    "openai": "^6.49.0",
    "playwright": "^1.62.0",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheWariend/CleanSlate.git",
    "directory": "packages/cleanslate-sdk"
  },
  "homepage": "https://github.com/TheWariend/CleanSlate/tree/main/packages/cleanslate-sdk",
  "bugs": {
    "url": "https://github.com/TheWariend/CleanSlate/issues"
  },
  "keywords": [
    "agent",
    "ai",
    "coding-agent",
    "runtime",
    "sdk",
    "slate"
  ],
  "publishConfig": {
    "access": "public"
  }
}
