{
  "name": "@cleanslate/cli",
  "version": "0.1.0",
  "description": "Run the CleanSlate agent from a terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cleanslate": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix ../slate-sdk run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slate/sdk": "file:../slate-sdk",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^5.6.0"
  }
}
