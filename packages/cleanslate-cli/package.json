{
  "name": "@cleanslate/cli",
  "version": "1.0.7",
  "description": "CleanSlate coding agent for the terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cleanslate": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "!dist/*.test.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix ../cleanslate-sdk run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@cleanslate/sdk": "^1.0.7",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheWariend/CleanSlate.git",
    "directory": "packages/cleanslate-cli"
  },
  "homepage": "https://github.com/TheWariend/CleanSlate/tree/main/packages/cleanslate-cli",
  "bugs": {
    "url": "https://github.com/TheWariend/CleanSlate/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "coding-agent",
    "cleanslate"
  ],
  "publishConfig": {
    "access": "public"
  }
}
